<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bingo789</groupId>
        <artifactId>bingo-wallet</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bingo-wallet-service</artifactId>
    <description>Wallet: balances, debit/credit, ledger. Independent deployment and independent database.</description>

    <dependencies>
        <dependency>
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-wallet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <!-- walletTxnRetentionJob -->
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-common-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-common-mq</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
