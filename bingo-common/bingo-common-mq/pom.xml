<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bingo789</groupId>
        <artifactId>bingo-common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bingo-common-mq</artifactId>
    <description>Event catalog, Kafka transactional outbox and business-event listener factory</description>

    <dependencies>
        <dependency>
            <groupId>com.bingo789</groupId>
            <artifactId>bingo-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <!-- outbox relay and the business-event listener factory; services that use them add spring-boot-starter-kafka -->
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- Boot 4 Kafka auto-configuration (KafkaAutoConfiguration, listener factory configurer) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <!-- outbox relay; services that enable the outbox already have a DataSource -->
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
